# Copia este archivo como .env y pon tus llaves S3 de Copernicus Data Space.
# Se generan gratis en https://eodata-s3keysmanager.dataspace.copernicus.eu/panel/s3-credentials
# .env está en .gitignore: nunca se sube al repositorio.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
# Llave de la API de Anthropic para el chat de `cdcol web` (ADR 0006). Se crea en
# https://console.anthropic.com → API Keys; pon ahí también un límite de gasto mensual.
ANTHROPIC_API_KEY=
